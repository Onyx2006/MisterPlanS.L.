{
    "name": "oliver/misterplan-reservas",
    "description": "Prueba técnica MisterPlan: gestión de reservas en PHP nativo + Twig + JS",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}