<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Reservas{% endblock %} · MisterPlan</title>
    <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>
    <header class="cabecera">
        <a href="/">Reservas de alojamiento</a>
    </header>

    <main>
        {# Región viva: el JS escribe los avisos de éxito/error (con textContent, nunca innerHTML por seguridad de inyecciones). #}
        <div id="aviso" role="status" aria-live="polite" hidden></div>

        {% block contenido %}{% endblock %}
    </main>

    {% block scripts %}{% endblock %}
</body>
</html>